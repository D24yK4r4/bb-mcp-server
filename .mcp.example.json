{
  "_comment": "Copy to .mcp.json in your project root. Adjust paths to match your install.",
  "mcpServers": {
    "bb-hunter": {
      "command": "python3",
      "args": ["/ABSOLUTE/PATH/TO/bb-mcp-server/server/server.py"],
      "env": {
        "BB_ROOT":    "/ABSOLUTE/PATH/TO/your-bug-bounty-workspace",
        "BB_VAULT":   "/ABSOLUTE/PATH/TO/local-vault-dir",
        "BB_SCRIPTS": "/ABSOLUTE/PATH/TO/your-scripts-dir"
      }
    }
  }
}
